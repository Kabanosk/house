#!/usr/bin/env python3
"""Run a house task (or any prompt file) through Codex CLI.

usage: codex-task [--dry-run] [--read-only] [--json-log FILE] [--brief-file FILE] <task-or-prompt-file> <workdir>

If the file is a task (.house/tasks/T###-*.md with `id:` frontmatter), Codex is told to write its report to
$HOUSE_DIR/reports/<id>.md. HOUSE_DIR = the file's .house/ ancestor, or $HOUSE_DIR.
With `--json-log FILE`, Codex runs with `--json` and stdin /dev/null; its stdout (one JSON event per line, the
first is `thread.started` with `thread_id`) goes to FILE, and a last line `codex-task: exit <code>, log <FILE>` is
printed. With `--brief-file FILE` (a hand-off brief written by `house night` for attempt 2 and later), the file's
content is added to the prompt under the heading `Hand-off from earlier attempts:`; a missing or unreadable file is a
usage error. Exit codes: 0 ok, 2 usage, 3 codex not installed, other = codex's exit code.

Used by: the `coder-codex` driver agent (generated by `house adapt`) and `house night` for tasks whose agent is
`coder-codex`. Codex runs in a workspace-write sandbox (the workdir and the contest's `.house/`), or read-only
with `--read-only`. It does not commit: the driver reviews `house guard diff`, commits on the task branch, and
runs `house check`. Tasks must fit in about 10 minutes.
"""
import argparse
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path


def house_dir(path: Path) -> Path | None:
    """Find the `.house/` directory a file belongs to.

    Args:
        path: A file, usually a task file; its resolved ancestors are searched for a directory named `.house`.

    Returns:
        That `.house` directory, else `$HOUSE_DIR` from the environment, else None.
    """
    for parent in path.resolve().parents:
        if parent.name == ".house":
            return parent
    env = os.environ.get("HOUSE_DIR")
    return Path(env) if env else None


def main() -> int:
    """Parse the command line, build the `codex exec` command and run it.

    Returns:
        0 for `--dry-run` (the command is printed), 2 when the file does not exist, 3 when `codex` is not on PATH,
        otherwise Codex's own exit code. Arguments: `file` (task or prompt file), `workdir` (Codex's `-C` directory),
        `--dry-run`, `--read-only`, `--json-log` (FILE that receives Codex's JSON event stream; its parent
        directories are created), `--brief-file` (FILE whose content is added to the prompt under
        `Hand-off from earlier attempts:`; 2 when it cannot be read).
    """
    p = argparse.ArgumentParser(prog="codex-task")
    p.add_argument("--dry-run", action="store_true", help="print the command instead of running it")
    p.add_argument("--read-only", action="store_true", help="read-only sandbox (no edits)")
    p.add_argument("--json-log", type=Path, metavar="FILE",
                   help="run codex with --json (stdin /dev/null) and write its event stream to FILE")
    p.add_argument("--brief-file", type=Path, metavar="FILE",
                   help="add this file's content to the prompt as the hand-off from earlier attempts")
    p.add_argument("file", type=Path)
    p.add_argument("workdir", type=Path)
    a = p.parse_args()
    if not a.file.is_file():
        print(f"codex-task: no such file: {a.file}", file=sys.stderr)
        return 2
    text = a.file.read_text()
    prompt = text
    if a.brief_file:
        try:
            handoff = a.brief_file.read_text().strip()
        except (OSError, UnicodeDecodeError) as e:
            print(f"codex-task: cannot read brief file {a.brief_file}: {e}", file=sys.stderr)
            return 2
        prompt += f"\n\nHand-off from earlier attempts:\n{handoff}"
    m = re.search(r"^id:\s*(\S+)", text, re.M)
    hd = house_dir(a.file)
    hd = hd.resolve() if hd else None
    if m and hd:
        prompt += (
            f"\n\n---\nHOUSE_DIR is {hd}. Read {hd}/spec.yaml and {hd}/DECISIONS.md first. "
            f"When done, write your report (English) to {hd}/reports/{m.group(1)}.md using "
            f"{hd}/reports/TEMPLATE.md (its sections, ending with Next action: and Done when:), run every "
            "acceptance check and include the output. Add a Dead ends entry at the moment you abandon an "
            "approach (reason, number of tries, do not repeat), not only at the end. Keep Observed entries "
            "(each with its source: command or path:line) apart from Unverified guesses; cite files as path:line. "
            "Do not commit; the driver commits your changes."
        )
    if a.read_only:
        mode = ["--sandbox", "read-only"]
    else:
        # workspace-write: Codex may edit the workdir and, via --add-dir, the contest's .house/ (reports, ideas)
        mode = ["--sandbox", "workspace-write", "-c", "sandbox_workspace_write.network_access=true"]
        if hd:
            mode += ["--add-dir", str(hd)]
    cmd = ["codex", "exec", *mode, "-C", str(a.workdir), *(["--json"] if a.json_log else []), "--", prompt]
    if a.dry_run:
        print(shlex.join(cmd))
        return 0
    if not shutil.which("codex"):
        print("codex-task: codex CLI not found on PATH (fall back to the coder agent)", file=sys.stderr)
        return 3
    if not a.json_log:
        return subprocess.run(cmd).returncode
    a.json_log.parent.mkdir(parents=True, exist_ok=True)
    with a.json_log.open("w") as out:
        code = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=out).returncode
    print(f"codex-task: exit {code}, log {a.json_log}")
    return code


if __name__ == "__main__":
    sys.exit(main())
