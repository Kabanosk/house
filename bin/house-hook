#!/usr/bin/env python3
"""Claude Code hook entry point: `house-hook pre-tool` / `house-hook session-start` (JSON event on stdin).

Registered by `house adapt` in the contest's `settings.local.json`; Claude Code runs it before Edit/Write/Bash
tool calls (`pre-tool`) and when a session starts (`session-start`). The logic lives in `houselib.hook`.

Contract for agents:
  * `pre-tool`: exit 2 blocks the tool call and the reason on stderr is shown to the model; exit 0 allows it.
  * `session-start`: prints the contest state summary on stdout, exit 0.
  * Fail open: an unknown mode, bad input or any internal error prints one `house-hook: ...` line to stderr and
    exits 0, so a broken hook never blocks work. Only a guard rule blocks.
"""
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))


def main() -> int:
    """Run the hook selected by `sys.argv[1]` (`pre-tool` or `session-start`) on the JSON event read from stdin.

    Returns:
        The process exit code: 2 only when `pre-tool` blocks the call (reason printed to stderr); 0 otherwise,
        including unknown modes and any internal error (fail open, one warning line on stderr).
    """
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        from houselib import hook

        event = json.loads(sys.stdin.read() or "{}")
        if mode == "pre-tool":
            code, message = hook.pre_tool(event, dict(os.environ))
            if message:
                print(message, file=sys.stderr)
            return code
        if mode == "session-start":
            sys.stdout.write(hook.session_start(event))
            return 0
        print(f"house-hook: unknown mode {mode!r}", file=sys.stderr)
        return 0
    except Exception as e:  # noqa: BLE001 — a hook must never break the session (fail open)
        print(f"house-hook: skipped ({type(e).__name__}: {e})", file=sys.stderr)
        return 0


if __name__ == "__main__":
    sys.exit(main())
