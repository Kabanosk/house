#!/usr/bin/env python3
"""Claude Code hook entry point: `house-hook <mode>` with the JSON event on stdin.

Modes: `pre-tool`, `post-tool`, `session-start`. Registered by `house adapt` in the contest's
`settings.local.json`; Claude Code runs it before Edit/Write/Bash tool calls (`pre-tool`) and when a session starts
or resumes, also after a compaction (`session-start`). The logic lives in `houselib.hook`.

Contract for agents:
  * `pre-tool`: exit 2 blocks the tool call and the reason on stderr is shown to the model; exit 0 allows it.
  * `session-start`: prints the contest state summary on stdout, exit 0. With `source: "compact"` it prints the
    restored state instead (human decisions verbatim, questions, unfinished tasks), at most 10 000 characters.
  * `pre-compact`, `post-compact`: removed (K5 showed no gain over Claude Code's own compaction instructions); they
    exit 0 silently so settings written by an older `house adapt` keep working until it runs again.
  * Fail open: an unknown mode, bad input or any internal error prints one `house-hook: ...` line to stderr and
    exits 0, so a broken hook never blocks work. Only a guard rule blocks. Exception: in a job started from Signal
    (`HOUSE_AGENT_JOB` set) `pre-tool` fails closed (exit 2).
"""
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))


def main() -> int:
    """Run the hook selected by `sys.argv[1]` (see the module docstring for the modes) on the JSON event read from stdin.

    Returns:
        The process exit code: 2 only when `pre-tool` blocks the call (reason printed to stderr); 0 otherwise,
        including unknown modes and any internal error (fail open, one warning line on stderr).
    """
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        from houselib import hook

        event = json.loads(sys.stdin.read() or "{}")
        if mode == "pre-tool":
            code, message = hook.pre_tool(event, dict(os.environ))
            if message:
                print(message, file=sys.stderr)
            return code
        if mode == "post-tool":
            note = hook.post_tool(event)
            if note:
                print(note)
            return 0
        if mode == "session-start":
            sys.stdout.write(hook.session_start(event))
            return 0
        if mode in ("pre-compact", "post-compact"):  # gone (K5: Claude Code's own compaction); settings from an
            return 0                                   # older `house adapt` may still call them until the next adapt
        print(f"house-hook: unknown mode {mode!r}", file=sys.stderr)
        return 0
    except Exception as e:  # noqa: BLE001 — a hook must never break the session (fail open) …
        if os.environ.get("HOUSE_AGENT_JOB") and mode == "pre-tool":  # … except in a Signal job: fail closed
            print(f"house-hook: refused in job mode ({type(e).__name__})", file=sys.stderr)
            return 2
        print(f"house-hook: skipped ({type(e).__name__}: {e})", file=sys.stderr)
        return 0


if __name__ == "__main__":
    sys.exit(main())
